{
  "name": "pumice",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight desktop notes application for plain-Markdown vaults",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-reporter=spec test/*.test.mjs test/*.test.js",
    "test:shell": "node --test --test-reporter=spec test/*.test.mjs",
    "test:vault": "node --test test/*.test.js",
    "smoke": "electron . --smoke-test",
    "smoke:headless": "bash scripts/smoke-headless.sh",
    "e2e:data-safety": "bash scripts/e2e-data-safety.sh"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "jsdom": "^31.0.1"
  },
  "license": "UNLICENSED"
}
